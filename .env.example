# ASTU Campus Map & AI Guide Environment Configuration

# Groq API Key for the AI Campus Guide
# Free API keys are available at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model choice (defaults to llama-3.3-70b-versatile if omitted)
# Recommended options:
# - llama-3.3-70b-versatile  (Best balance of reasoning accuracy and speed)
# - llama-3.1-8b-instant     (Ultra-fast, lowest latency)
# - mixtral-8x7b-32768       (Alternative high-context open model)
GROQ_MODEL=llama-3.3-70b-versatile
